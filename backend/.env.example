# Environment variables. Never commit the real .env file.
# Copy this file to .env and fill in real values.

APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string-minimum-32-chars

# Development only: on a database without a super admin, create user "admin" with this password at start.
# Leave unset in shared installs; there are no built-in default passwords.
# ATM_DEV_ADMIN_PASSWORD=

# SQLite file of the app (default: backend/unifiedwork.db). The UI tests point it at a throwaway file.
# ATM_DATABASE_PATH=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://testmanager:testmanager@localhost:5432/testmanager

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS (frontend URL)
# CORS_ORIGINS=["http://localhost:5173"]

# GitHub PAT (Personal Access Token) — scope: repo (read)
GITHUB_TOKEN=ghp_replace_with_your_token

# Docker runner limits
DOCKER_RUNNER_NETWORK=none
DOCKER_RUNNER_MEM_LIMIT=512m
DOCKER_RUNNER_CPU_QUOTA=50000

# Mobile devices (Test Run > Devices). Optional: defaults to ANDROID_SDK_ROOT /
# ANDROID_HOME env vars or the standard Android Studio SDK location
# (macOS ~/Library/Android/sdk, Windows %LOCALAPPDATA%\Android\Sdk, Linux ~/Android/Sdk).
# ANDROID_SDK_ROOT=/Users/you/Library/Android/sdk
# ANDROID_SDK_ROOT=C:\Users\you\AppData\Local\Android\Sdk
